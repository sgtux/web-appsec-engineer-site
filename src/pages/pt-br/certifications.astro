---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface MarkdownPost {
  frontmatter: { title: string; date: string; description: string; category: string };
  url: string;
}
const allCertifications = Object.values(import.meta.glob<MarkdownPost>('./certifications/*.md', { eager: true }));

const certificatios = allCertifications.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);

const categories = [...new Set(certificatios.map((p) => p.frontmatter.category))];
---

<BaseLayout
  title="Certifications"
  description="Algumas certificações sobre Segurança em Aplicações Web, Vulnerabilidades, CTFs, and Engenheiros de Segurança."
  lang="pt-BR"
>
  <div class="container">

    <div class="blog-header">
      <h1>Certificações</h1>
      <p>{certificatios.length} entradas · {categories.join(' · ')}</p>
    </div>

    <div class="posts-grid mb-4">
      {certificatios.map((certification) => {
        const formattedDate = new Date(certification.frontmatter.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <a href={certification.url} class="post-card">
            <div class="post-card-meta">
              <span class="post-card-date">{formattedDate}</span>
              <span class="post-card-category">{certification.frontmatter.category}</span>
            </div>
            <div class="post-card-title">{certification.frontmatter.title}</div>
            <p class="post-card-excerpt">{certification.frontmatter.description}</p>
            <span class="post-card-arrow">→</span>
          </a>
        );
      })}
    </div>

  </div>
</BaseLayout>
