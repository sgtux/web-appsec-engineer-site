---
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await Astro.glob('./posts/*.md');

const posts = allPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout title="Web AppSec Engineer" lang="en-US">
  <div class="container">

    <!-- ── HERO ── -->
    <section class="hero">
      <p class="hero-eyebrow">Security Research &amp; Engineering</p>
      <h1 class="hero-title">
        Web AppSec<br /><em>Engineer</em>
      </h1>
      <p class="hero-desc">
        Applied research in web application security. Vulnerabilities,
        hands-on labs, CTFs, applied cryptography, and secure development —
        documented with technical precision.
      </p>
      <div class="hero-tags">
        <span class="tag">Web Security</span>
        <span class="tag">OWASP</span>
        <span class="tag">CTF</span>
        <span class="tag">Cryptography</span>
        <span class="tag">Secure Dev</span>
        <span class="tag">Pentesting</span>
        <span class="tag">Bug Bounty</span>
      </div>
    </section>

    <div class="ornament">
      <span class="ornament-symbol">🕵️</span>
    </div>

    <!-- ── INTRO ── -->
    <section class="mb-4">
      <div class="intro-box">
        <p>
          This space compiles studies, technical notes, and labs on web
          application security. The content ranges from classic vulnerabilities
          like XSS and SQL Injection to advanced analysis and exploitation
          techniques. The goal is to document the learning process in a
          structured way — like a security engineering grimoire, built layer
          by layer.
        </p>
      </div>
    </section>

    <!-- ── RECENT POSTS ── -->
    <section class="mb-4">
      <div class="section-heading">
        <h2>Recent Posts</h2>
        <span class="section-heading-line"></span>
        <a href="/en-us/blog" class="text-mono text-dim"
           style="white-space: nowrap; font-size: 0.68rem; letter-spacing: 0.1em; text-decoration: none; transition: color 0.2s;"
           onmouseover="this.style.color='var(--cyan)'"
           onmouseout="this.style.color='var(--text-dim)'">
          see all →
        </a>
      </div>

      <div class="posts-grid">
        {posts.map((post) => {
          const formattedDate = new Date(post.frontmatter.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <a href={post.url} class="post-card">
              <div class="post-card-meta">
                <span class="post-card-date">{formattedDate}</span>
                <span class="post-card-category">{post.frontmatter.category}</span>
              </div>
              <div class="post-card-title">{post.frontmatter.title}</div>
              <p class="post-card-excerpt">{post.frontmatter.description}</p>
              <span class="post-card-arrow">→</span>
            </a>
          );
        })}
      </div>
    </section>

  </div>
</BaseLayout>
