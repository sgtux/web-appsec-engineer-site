---
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await Astro.glob('./posts/*.md');

const posts = allPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);

const categories = [...new Set(posts.map((p) => p.frontmatter.category))];
---

<BaseLayout
  title="Blog"
  description="All posts on web application security, vulnerabilities, CTFs, and security engineering."
  lang="en-US"
>
  <div class="container">

    <div class="blog-header">
      <h1>Post Archive</h1>
      <p>{posts.length} entries · {categories.join(' · ')}</p>
    </div>

    <div class="posts-grid mb-4">
      {posts.map((post) => {
        const formattedDate = new Date(post.frontmatter.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <a href={post.url} class="post-card">
            <div class="post-card-meta">
              <span class="post-card-date">{formattedDate}</span>
              <span class="post-card-category">{post.frontmatter.category}</span>
            </div>
            <div class="post-card-title">{post.frontmatter.title}</div>
            <p class="post-card-excerpt">{post.frontmatter.description}</p>
            <span class="post-card-arrow">→</span>
          </a>
        );
      })}
    </div>

  </div>
</BaseLayout>
